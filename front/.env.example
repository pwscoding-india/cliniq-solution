# ===========================================
# Clinic Solution Frontend - Environment Variables
# A product by pwscoding.co.in
# ===========================================

# Backend API URL (required)
# Use your deployed backend URL for production
# Example: https://cliniq-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002

# ===========================================
# Firebase Configuration (required)
# Get these values from your Firebase Console:
# https://console.firebase.google.com/project/_/settings/general/
# ===========================================

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Clerk Configuration (if using Clerk for auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxx
